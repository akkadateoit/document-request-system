# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=document_request
DB_PASSWORD=change-me
DB_NAME=document_request_system
DB_PORT=5432

# Server
PORT=3200
# Long random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=change-me

# Not used by the code yet: bank details are hard-coded in public/js/request.js
BANK_ACCOUNT=
BANK_NAME=

# LINE Messaging API (optional). Without a token, new-request notifications are skipped.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ID=

# Notification target: the first one that is set wins, in this order
LINE_GROUP_ID=
# LINE_NOTIFY_USERS=userId1,userId2
# LINE_ADMIN_USER_ID=
