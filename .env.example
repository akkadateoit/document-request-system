# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=document_request
DB_PASSWORD=change-me
DB_NAME=document_request_system
DB_PORT=5432

# Server
PORT=3200
# Long random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
JWT_SECRET=change-me

# Not used by the code yet: bank details are hard-coded in public/js/request.js
BANK_ACCOUNT=
BANK_NAME=

# Public URL of this install, used to build password-reset links in emails.
# Required for "forgot password". Never derive it from the request Host header.
APP_URL=https://document.example.ac.th

# Outgoing email for "forgot password". The feature and its login link stay hidden until these are set.
# Google Workspace: create an App Password for the sender account (2-Step Verification required).
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE: optional; defaults to true for port 465 and false (STARTTLS, required) otherwise
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# MAIL_TRANSPORT=log   # testing: print emails to the log instead of sending

# LINE Messaging API (optional). Without a token, new-request notifications are skipped.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ID=

# Notification target: the first one that is set wins, in this order
LINE_GROUP_ID=
# LINE_NOTIFY_USERS=userId1,userId2
# LINE_ADMIN_USER_ID=
